  "coordinator": "orchestrator",

  "legacyAnalysis": {
    "sourceFiles": [
      "legacy-firmware/firmware/src/brevitest-firmware.ino",
      "legacy-firmware/firmware/src/brevitest-firmware.h",
      "legacy-firmware/firmware/src/DeviceState.cpp",
