{
  "project": "Brevitest Supabase Firmware Rewrite",
  "branchName": "firmware-rewrite-supabase",
  "version": "1.0.0",
  "description": "Complete rewrite of Brevitest firmware to match legacy behavior while integrating Supabase cloud backend. This master PRD coordinates multiple sub-PRDs for parallel development.",
