      "legacy-firmware/firmware/src/DFRobot_AS7341.cpp",
      "legacy-firmware/firmware/src/DFRobot_AS7341.h"
    ],
    "totalLinesOfCode": 6200,
    "firmwareVersion": 56,
    "dataFormatVersion": 39
  },

  "architecture": {
    "targetPlatform": "Particle Boron (NRF52840)",
    "deviceOS": "6.3.3",
    "cloudBackend": "Supabase Edge Functions",
    "modules": [
      "StateMachine - Core state management with validated transitions",
      "HAL - Hardware abstraction layer for pins and peripherals",
      "MotorController - Stepper motor control with limit detection",
      "HeaterController - PID temperature control with thermistor",
      "LaserController - 3-channel laser control with photodiodes",
      "Spectrophotometer - AS7341 11-channel sensor control",
      "BarcodeScanner - Serial barcode reader interface",
      "BuzzerController - Audio feedback patterns",
      "LEDController - RGB status indicators",
      "StorageManager - EEPROM and filesystem operations",
      "SupabaseClient - Cloud API communication",
      "SerialCommands - Diagnostic command interface",
      "BCODEInterpreter - Test script execution engine",
      "TestRunner - Test orchestration and data collection"
    ]
  },

