  "qualityGates": {
    "codeReview": {
      "required": true,
      "checklist": [
        "Matches legacy behavior exactly (document deviations)",
        "No AI slop - clear, purposeful code",
        "Proper error handling with meaningful messages",
        "Memory-safe operations (no buffer overflows)",
        "Thread-safe where applicable",
        "Comprehensive logging for diagnostics"
      ]
    },
    "documentation": {
      "required": true,
      "checklist": [
        "Function-level documentation with @brief, @param, @return",
        "State transition diagrams for state machines",
        "Hardware timing requirements documented",
        "Pin assignments and electrical requirements",
        "Error codes and recovery procedures"
      ]
    },
    "testing": {
      "required": true,
      "checklist": [
        "Unit tests for state transitions",
        "Hardware simulation tests where possible",
        "Serial command response validation",
        "Timing-critical operation verification"
      ]
    }
